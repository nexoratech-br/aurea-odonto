---
import '../styles/hero.css';
---
<section id="inicio" class="hero hero-v2" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">ODONTOLOGIA CONTEMPORÂNEA</p>
    <h1 id="hero-title">
      <span>Precisão no</span>
      <span>cuidado.</span>
      <span class="hero-title-accent">Naturalidade</span>
      <span class="hero-title-accent">no sorriso.</span>
    </h1>
    <p class="hero-description">Tecnologia, precisão e cuidado em cada detalhe. Tratamentos pensados para resultados naturais e uma experiência mais confortável.</p>
    <div class="hero-actions">
      <a href="#contato" class="button button-dark">Agendar avaliação</a>
      <a href="#tratamentos" class="text-link"><span>Explorar tratamentos</span></a>
    </div>

  </div>
  <aside class="hero-note" aria-label="Nossa abordagem">
    <p class="hero-note-statement">Cuidado planejado para você</p>
    <p class="hero-note-description">Cada tratamento começa com diagnóstico, escuta e precisão.</p>
    <a href="#experiencia" class="hero-note-bottom"><span>Conheça nossa abordagem</span></a>
  </aside>
  <div class="hero-art">
    <picture>
      <source srcset="/images/hero-clinic-v2-720.webp 720w, /images/hero-clinic-v2.webp 1120w" sizes="100vw" type="image/webp" />
      <img id="hero-image" src="/images/hero-clinic-v2.webp" width="1120" height="1400" alt="Ambiente odontológico fictício com cadeira em marfim, pedra natural e luz do sol. Imagem conceitual gerada por IA." fetchpriority="high" decoding="async" />
    </picture>


  </div>



</section>



