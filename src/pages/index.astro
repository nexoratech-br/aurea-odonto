---
import Layout from '../layouts/Layout.astro';
import '../styles/sections.css';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Treatments from '../components/Treatments.astro';
import Experience from '../components/Experience.astro';
import Technology from '../components/Technology.astro';

import Team from '../components/Team.astro';
import LocationContact from '../components/LocationContact.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import ContactToast from '../components/ContactToast.astro';
---
<Layout>
  <Navbar />
  <main id="conteudo">
    <Hero />
    <Treatments />
    <Experience />
    <Technology />

    <Team />
    <LocationContact />
    <FinalCTA />
  </main>
  <Footer />
  <ContactToast />
</Layout>

